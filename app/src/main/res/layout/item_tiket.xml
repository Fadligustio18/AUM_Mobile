<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_grid_shadow"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_siswa_tiket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Siswa"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_status_tiket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Dikirim"
                android:textColor="@color/brand_primary"
                android:background="@drawable/bg_status_dikirim"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="12sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_judul_tiket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Judul Konseling"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_tanggal_tiket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="09/04/2026 23:54:36"
            android:textSize="12sp"
            android:textColor="@color/text_color_secondary" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
