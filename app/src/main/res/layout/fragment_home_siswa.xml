<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".fragment.homeFragment"
    tools:ignore="Overdraw">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/img_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="@string/bk"
                app:titleTextAppearance="@style/ToolbarTitleBold"
                app:titleCentered="false"
                app:titleTextColor="@color/white"
                app:contentInsetStart="0dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Profile Section in Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="50dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_profile_home"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:padding="2dp"
                    android:background="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
                    android:src="@drawable/person_icon"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/white" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/tv_name_home"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ex_name"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_school_home"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ex_school"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:alpha="0.9" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_home_siswa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/linear_container_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Section Title -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instrument_title"
                    android:textColor="@color/text_color_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/instrument_count"
                    android:textColor="@color/text_color_secondary"
                    android:textSize="12sp" />
            </RelativeLayout>

            <!-- Card 1: AUM -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_aum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"

                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_grid_shadow">

                    <!-- Header -->
                    <RelativeLayout
                        android:id="@+id/header_aum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/icon_aum"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:background="@color/brand_soft"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded8"
                            android:src="@drawable/img_9"
                            app:tint="@color/brand_primary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@id/icon_aum"
                            android:layout_toStartOf="@id/arrow_aum"
                            android:text="@string/aum_title"
                            android:textColor="@color/text_color_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/arrow_aum"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@color/brand_soft"
                            android:padding="8dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/brand_primary"
                            android:rotation="90" />
                    </RelativeLayout>

                    <!-- Expandable Content -->
                    <LinearLayout
                        android:id="@+id/expandable_aum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider_color"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/badge_aum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_brand"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="@string/status_belum_isi"
                            android:textColor="@color/brand_primary"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/aum_desc"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_mulai_aum"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/btn_mulai_isi"
                            android:textAllCaps="false"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_edit"
                            android:backgroundTint="@color/brand_primary"
                            android:textColor="@color/white"
                            app:iconTint="@color/white"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Sosiografik -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_sosio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"

                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_grid_shadow">

                    <!-- Header -->
                    <RelativeLayout
                        android:id="@+id/header_sosio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/icon_sosio"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:background="@color/accent_pink_soft"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded8"
                            android:src="@drawable/img_8"
                            app:tint="@color/accent_pink_text" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@id/icon_sosio"
                            android:layout_toStartOf="@id/arrow_sosio"
                            android:text="@string/sosiografik_title"
                            android:textColor="@color/text_color_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/arrow_sosio"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@color/accent_pink_soft"
                            android:padding="8dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/accent_pink_text"
                            android:rotation="90" />
                    </RelativeLayout>

                    <!-- Expandable Content -->
                    <LinearLayout
                        android:id="@+id/expandable_sosio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider_color"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/badge_sosio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_green"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="@string/status_selesai"
                            android:textColor="@color/green_text"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sosiografik_desc"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_lihat_sosio"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/btn_lihat_hasil"
                            android:textAllCaps="false"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_eye"
                            app:strokeColor="@color/brand_primary"
                            android:textColor="@color/brand_primary"
                            app:iconTint="@color/brand_primary"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Gaya Belajar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gaya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"

                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_grid_shadow">

                    <!-- Header -->
                    <RelativeLayout
                        android:id="@+id/header_gaya"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/icon_gaya"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:background="@color/accent_peach_soft"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded8"
                            android:src="@drawable/img_10"
                            app:tint="@color/accent_peach_text" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@id/icon_gaya"
                            android:layout_toStartOf="@id/arrow_gaya"
                            android:text="@string/gaya_belajar_title"
                            android:textColor="@color/text_color_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/arrow_gaya"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@color/accent_peach_soft"
                            android:padding="8dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/accent_peach_text"
                            android:rotation="90" />
                    </RelativeLayout>

                    <!-- Expandable Content -->
                    <LinearLayout
                        android:id="@+id/expandable_gaya"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider_color"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/badge_gaya"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_brand"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="@string/status_belum_isi"
                            android:textColor="@color/brand_primary"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/gaya_belajar_desc"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_mulai_gaya"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/btn_mulai_isi"
                            android:textAllCaps="false"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_edit"
                            android:backgroundTint="@color/brand_primary"
                            android:textColor="@color/white"
                            app:iconTint="@color/white"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
