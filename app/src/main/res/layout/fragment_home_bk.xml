<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".fragment.homeBkFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/img_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar_bk"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Dashboard Guru BK"
                app:titleTextAppearance="@style/ToolbarTitleBold"
                app:titleCentered="false"
                app:titleTextColor="@color/white"
                app:contentInsetStart="0dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Profile Section in Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="50dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_profile_bk"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:padding="2dp"
                    android:background="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
                    android:src="@drawable/person_icon"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/white" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selamat Datang,"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:alpha="0.9" />

                    <TextView
                        android:id="@+id/tv_name_bk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guru BK"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_home_bk"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="160dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu Pengelolaan"
                android:textColor="@color/text_color_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Management Grid using nested LinearLayouts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="-8dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Kelola Data Siswa -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_data_siswa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="16dp"

                        app:strokeWidth="0dp"
                        android:clickable="true"
                        android:focusable="true"

                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"

                            android:padding="16dp"
                            android:background="@drawable/bg_grid_shadow"
                            android:gravity="center">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@color/brand_soft"
                                android:padding="10dp"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded8"
                                android:src="@drawable/img_2"
                                app:tint="@color/brand_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Data Siswa"
                                android:textColor="@color/text_color_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Kelola Data AUM -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_data_aum"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="16dp"

                        app:strokeWidth="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:background="@drawable/bg_grid_shadow"
                            android:gravity="center">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@color/accent_pink_soft"
                                android:padding="10dp"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded8"
                                android:src="@drawable/img_9"
                                app:tint="@color/accent_pink_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Data AUM"
                                android:textColor="@color/text_color_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- CRUD Sosiografik -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_sosio_bk"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="16dp"

                        app:strokeWidth="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:background="@drawable/bg_grid_shadow"
                            android:gravity="center">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@color/accent_peach_soft"
                                android:padding="10dp"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded8"
                                android:src="@drawable/img_8"
                                app:tint="@color/accent_peach_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Sosiografik"
                                android:textColor="@color/text_color_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Inventori Gaya Belajar -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_gaya_belajar_bk"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="16dp"

                        app:strokeWidth="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:background="@drawable/bg_grid_shadow"
                            android:gravity="center">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@color/brand_soft"
                                android:padding="10dp"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded8"
                                android:src="@drawable/img_10"
                                app:tint="@color/brand_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Gaya Belajar"
                                android:textColor="@color/text_color_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>



        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
