<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_grid_shadow"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_judul_kuesioner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Judul Kuesioner"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_color_primary" />

        <TextView
            android:id="@+id/tv_deskripsi_kuesioner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Deskripsi kuesioner..."
            android:textSize="14sp"
            android:textColor="@color/text_color_secondary"
            android:maxLines="2"
            android:ellipsize="end" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginVertical="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_info_kelas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kelas: 12 PPLG 1"
                android:textSize="12sp"
                android:textColor="@color/brand_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_info_tahun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="2025/2026"
                android:textSize="12sp"
                android:textColor="@color/brand_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tanggal_kuesioner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09/05/2026"
                android:textSize="12sp"
                android:textColor="@color/text_color_secondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_status_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sudah Dikerjakan"
            android:textColor="@color/green_text"
            android:background="@drawable/bg_status_disetujui"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
