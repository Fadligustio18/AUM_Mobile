<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity.guruBkActivity">

    <!-- Kontainer Fragment -->
    <FrameLayout
        android:id="@+id/fragment_container_bk"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Floating Bottom Navigation -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/nav_card_bk"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="@drawable/bg_header"
            android:weightSum="2">

            <!-- Item Home -->
            <LinearLayout
                android:id="@+id/btn_nav_home_bk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/dot_home_bk"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/nav_dot_indicator"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/ic_nav_home_bk"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/img_13"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:id="@+id/tv_nav_home_bk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Home"
                    android:textColor="@color/brand_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Item Profil -->
            <LinearLayout
                android:id="@+id/btn_nav_profil_bk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/dot_profil_bk"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/nav_dot_indicator"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/ic_nav_profil_bk"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/img_14"
                    app:tint="@color/text_color_secondary" />

                <TextView
                    android:id="@+id/tv_nav_profil_bk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Profil"
                    android:textColor="@color/text_color_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
