<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Ekor Balon (Kotak yang diputar 45 derajat agar jadi segitiga) -->
    <item
        android:width="14dp"
        android:height="14dp"
        android:left="20dp"
        android:top="2dp">
        <rotate
            android:fromDegrees="45"
            android:toDegrees="45">
            <shape android:shape="rectangle">
                <solid android:color="@color/brand_soft" />
                <stroke android:width="1.5dp" android:color="@color/brand_primary" />
            </shape>
        </rotate>
    </item>

    <!-- 2. Badan Balon (Diberi margin top agar tidak menutupi ekor) -->
    <item android:top="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_soft" />
            <stroke android:width="1.5dp" android:color="@color/brand_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- 3. Penutup (Masking) untuk menghilangkan garis stroke di pertemuan ekor dan badan -->
    <item
        android:width="20dp"
        android:height="10dp"
        android:left="17dp"
        android:top="9.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_soft" />
        </shape>
    </item>
</layer-list>
